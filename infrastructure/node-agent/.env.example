# ==============================================================================
# ANTIGRAVITY COMMERCIAL VPN - EDGE NODE AGENT DAEMON (.env.example)
# ==============================================================================

# Port for edge node agent daemon (NestJS backend calls this port)
AGENT_PORT=51821

# Pre-shared mutual authentication secret (Must match central backend NODE_AGENT_TOKEN)
NODE_AGENT_TOKEN="vpn-node-agent-secure-token-2026"

# Linux WireGuard kernel interface & configuration path
WG_INTERFACE=wg0
WG_CONF_PATH=/etc/wireguard/wg0.conf

# Central Control Plane API URL for edge node self-registration & telemetry
BACKEND_URL=https://api.yourdomain.com/api/v1

# Edge Node Public Identity (Auto-discovered if omitted)
SERVER_PUBLIC_IP=195.201.10.45
SERVER_COUNTRY_CODE=DE
SERVER_COUNTRY_NAME="Germany"
SERVER_CITY="Frankfurt"
SERVER_MAX_CAPACITY=500
