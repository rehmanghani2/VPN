# Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vpn_db?schema=public"

# Redis Configuration (Optional Session / Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
JWT_SECRET="super-secure-vpn-control-plane-jwt-secret-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secure-vpn-refresh-token-secret-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Device Quotas
FREE_MAX_DEVICES=1
BASIC_MAX_DEVICES=5
PREMIUM_MAX_DEVICES=10
