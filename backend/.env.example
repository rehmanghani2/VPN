# ==============================================================================
# ANTIGRAVITY COMMERCIAL VPN - CONTROL PLANE CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite (Local Development):
# DATABASE_URL="file:./dev.db"
# PostgreSQL (Production):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vpn_db?schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS DISTRIBUTED CACHE & SESSION STORE
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. JWT ENCRYPTION & SECURITY KEYS
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-ultra-secure-256bit-access-secret-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-ultra-secure-256bit-refresh-secret-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. EDGE SERVER & CLUSTER SYNCHRONIZATION
# ------------------------------------------------------------------------------
# Mutual authentication pre-shared secret between NestJS and Edge Node Agents (X-Node-Token)
NODE_AGENT_TOKEN="vpn-node-agent-secure-token-2026"
# Port where edge node agents listen on remote Linux hosts
AGENT_PORT=51821

# ------------------------------------------------------------------------------
# 6. COMMERCIAL SUBSCRIPTION & BILLING
# ------------------------------------------------------------------------------
# Stripe API Keys (Web & In-App Subscriptions)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# Apple In-App Purchases (iOS App Store Server API)
APPLE_IAP_SHARED_SECRET="your_apple_in_app_purchase_shared_secret"

# Google Play In-App Billing (Android Play Console Service Account)
GOOGLE_PLAY_KEY_PATH="./secrets/google-play-service-account.json"

# ------------------------------------------------------------------------------
# 7. SUBSCRIPTION DEVICE LIMITS & QUOTAS
# ------------------------------------------------------------------------------
FREE_MAX_DEVICES=1
BASIC_MAX_DEVICES=5
PREMIUM_MAX_DEVICES=10
FAMILY_MAX_DEVICES=10

# ------------------------------------------------------------------------------
# 8. CORS & NETWORK RESTRICTIONS
# ------------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://admin.yourdomain.com"
