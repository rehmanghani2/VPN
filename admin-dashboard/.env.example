# ==============================================================================
# ANTIGRAVITY COMMERCIAL VPN - NEXT.JS ADMIN DASHBOARD (.env.example)
# ==============================================================================

# Backend API URL for client-side browser requests
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Internal Backend Control Plane URL for Next.js SSR / API Rewrites
BACKEND_INTERNAL_URL=http://localhost:3000

# NextAuth / Cookie Secret Key (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-random-32-byte-hex-secret-for-admin-auth

# Portal Branding Title
NEXT_PUBLIC_APP_NAME="Antigravity VPN Admin Console"
